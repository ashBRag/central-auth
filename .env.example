# App
PORT=3001

# Database (shared dev-stack Postgres — see Dev Arsenal/Infrastructure/dev-stack/.env)
# Host `postgresql` resolves on the backend-internal Docker network (docker compose up).
DATABASE_URL=postgresql://postgres:password@postgresql:5432/mydatabase?schema=public

# Auth
JWT_ACCESS_SECRET=changeme-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh
JWT_REFRESH_EXPIRES_IN=7d
# Must match the issuer/audience/scope contract other services verify against
# (see libs.auth.require_scopes / docs/AUTH.md in data-masking-service).
JWT_ISSUER=central-auth
JWT_AUDIENCE=backend
JWT_DEFAULT_SCOPE=

# Redis (shared dev-stack Redis — see Dev Arsenal/Infrastructure/dev-stack/.env)
# Host `redis` resolves on the backend-internal Docker network (docker compose up).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password

# OAuth — Google
GOOGLE_CLIENT_ID=changeme-google-client-id
GOOGLE_CLIENT_SECRET=changeme-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/google/callback

# OAuth — default redirect target (used by prisma/seed.ts, request with ?redirect_slug=default)
OAUTH_DEFAULT_SUCCESS_URL=http://localhost:3000/auth/callback
OAUTH_DEFAULT_ERROR_URL=http://localhost:3000/auth/error

